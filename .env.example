# =====================================================================
#  ai-trading-platform — environment configuration (EXAMPLE)
#  Copy to `.env` and fill in. NEVER commit a real .env with secrets.
# =====================================================================

# ---- Runtime ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------
# Default is a local SQLite file so the platform runs with zero infra.
# For the docker-compose TimescaleDB stack use e.g.:
#   DATABASE_URL=postgresql+psycopg2://trader:trader@localhost:5432/trading
DATABASE_URL=sqlite:///./trading.db

# ---- AI analysis layer ---------------------------------------------
# How the platform authenticates to Claude:
#   oauth   -> use an `ant auth login` OAuth profile (recommended; no static
#              key), or an explicit ANTHROPIC_AUTH_TOKEN below.
#   api_key -> use ANTHROPIC_API_KEY.
#   off     -> never call Claude; always use the offline heuristic.
AI_AUTH_MODE=oauth
# OAuth bearer token (optional in oauth mode; leave blank to use the login
# profile). Get one with: ant auth print-credentials --access-token
ANTHROPIC_AUTH_TOKEN=
# Only used when AI_AUTH_MODE=api_key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# ---- SAFETY: live trading -------------------------------------------
# Live trading is HARD-disabled by default. Do not enable until the
# platform has documented performance via backtesting + paper trading.
LIVE_TRADING_ENABLED=false

# ---- Broker --------------------------------------------------------
# Default execution venue. Switch at runtime via POST /control/broker-mode.
#   simulation -> internal offline paper broker
#   saxo       -> Saxo Bank OpenAPI (sim env safe; live env gated)
DEFAULT_BROKER_MODE=simulation

# ---- Saxo Bank OpenAPI ---------------------------------------------
# SAXO_ENVIRONMENT: sim (fake money, safe) or live (requires LIVE_TRADING_ENABLED).
# SAXO_ACCESS_TOKEN comes from Saxo's OAuth flow (24h dev token for sim).
SAXO_ENVIRONMENT=sim
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_ACCESS_TOKEN=

# ---- Market data & news (v4/v5) ------------------------------------
# saxo = Saxo charts (default; falls back to synthetic if no token);
# yfinance = real Yahoo; synthetic = offline random walk.
MARKET_DATA_SOURCE=saxo
NEWS_ENABLED=true
MARKET_LOOKBACK_DAYS=365

# ---- Discovery / screener (v4) -------------------------------------
# When enabled, automation auto-selects the top-N screened symbols to trade.
# The pool is NOT limited to one market — set any tickers you want.
DISCOVERY_ENABLED=false
DISCOVERY_TOP_N=6
# Default is a global large-cap mix. Danish OMX names need ".CO" for yfinance.
# DISCOVERY_CANDIDATES=AAPL,MSFT,NVDA,NOVO-B.CO,MAERSK-B.CO,...

# ---- Automation (v3) -----------------------------------------------
AUTOMATION_INTERVAL_SECONDS=300

# ---- Portfolio ------------------------------------------------------
INITIAL_CASH=100000
BASE_CURRENCY=DKK

# ---- Decision thresholds (see app/config.py for full risk config) ---
QUANT_SCORE_THRESHOLD=70
NEWS_SCORE_THRESHOLD=70
